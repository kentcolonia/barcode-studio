[Unit]
Description=Barcode Studio
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/barcode-studio
EnvironmentFile=/etc/barcode-studio.env
ExecStart=/opt/barcode-studio/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/barcode-studio/data

[Install]
WantedBy=multi-user.target
